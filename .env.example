# All integrations are optional. Blank DB_PATH uses project data/faster.db.
DB_PATH=
STAFF_CODE=staff123
LIVE_FEED_KEY=dev-feed-key
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Direct Gemini; install the ai extra to enable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Databricks SQL outcomes; install the databricks extra.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
OUTCOMES_TABLE=faster.gold.outcomes
# For Databricks-served Gemini, set GEMINI_MODEL to your workspace model.

# Preserved capacity/history dashboard at /capacity/.
DATA_MODE=demo
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_GOLD_TABLE=workspace.faster.gold_hospital_status
DATABRICKS_HISTORY_VIEW=patient-info.default.nys_sparcs_discharges_2024_frontend
